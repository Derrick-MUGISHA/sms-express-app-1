generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  SUPERVISOR
  USER
}

enum MarkType {
  ASSIGNMENT
  QUIZ
  EXAM
  PROJECT
  PARTICIPATION
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleType {
  ELECTRIC
  SUV
  TRUCK
  MOTORCYCLE
  BUS
  VAN
  PICKUP
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  GAS
  OTHER
}

enum VehiclePurpose {
  PERSONAL
  COMMERCIAL
  TAXI
  GOVERNMENT
}

enum VehicleStatus {
  NEW
  USED
  REBUILT
}

enum OwnerType {
  INDIVIDUAL
  COMPANY
  NGO
  GOVERNMENT
}

enum RegistrationStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  PENDING
}

enum PlateType {
  PRIVATE
  COMMERCIAL
  GOVERNMENT
  DIPLOMATIC
  PERSONALIZED
}

enum InsuranceStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  email              String    @unique
  password           String
  role               Role      @default(STUDENT)
  isVerified         Boolean   @default(false)
  otp                String?
  otpExpires         DateTime?
  hashedRefreshToken String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enrollments       Enrollment[]
  attendances       Attendance[]      @relation("StudentAttendance")
  supervisorRecords Attendance[]      @relation("SupervisorAttendance")
  supervisedCourses Course[]          @relation("CourseSupervisor")
  studentMarks      Mark[]            @relation("StudentMarks")
  supervisorMarks   Mark[]            @relation("SupervisorMarks")
  studentClaims     AttendanceClaim[] @relation("StudentClaims")
  resolvedClaims    AttendanceClaim[] @relation("ResolvedClaims")
}

model Course {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  courseName   String
  description  String
  supervisorId String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supervisor  User?             @relation("CourseSupervisor", fields: [supervisorId], references: [id])
  enrollments Enrollment[]
  attendances Attendance[]
  marks       Mark[]
  claims      AttendanceClaim[]
}

model Enrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  courseId  String   @db.ObjectId
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Attendance {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  courseId     String   @db.ObjectId
  supervisorId String   @db.ObjectId
  date         DateTime @default(now())
  status       Boolean

  student    User   @relation("StudentAttendance", fields: [userId], references: [id])
  course     Course @relation(fields: [courseId], references: [id])
  supervisor User   @relation("SupervisorAttendance", fields: [supervisorId], references: [id])
}

model Mark {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  courseId     String   @db.ObjectId
  supervisorId String   @db.ObjectId
  title        String
  score        Float
  maxScore     Float
  type         MarkType @default(ASSIGNMENT)
  feedback     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    User   @relation("StudentMarks", fields: [userId], references: [id])
  course     Course @relation(fields: [courseId], references: [id])
  supervisor User   @relation("SupervisorMarks", fields: [supervisorId], references: [id])
}

model AttendanceClaim {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  userId     String      @db.ObjectId
  courseId   String      @db.ObjectId
  date       DateTime
  reason     String
  status     ClaimStatus @default(PENDING)
  resolvedBy String?     @db.ObjectId
  resolution String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  student  User    @relation("StudentClaims", fields: [userId], references: [id])
  course   Course  @relation(fields: [courseId], references: [id])
  resolver User?   @relation("ResolvedClaims", fields: [resolvedBy], references: [id])
}

model Story {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  authorName String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Vehicle {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  manufacture     String
  model           String
  year            Int
  vehicleType     VehicleType
  bodyType        String
  color           String
  fuelType        FuelType
  engineCapacity  Int
  odometerReading Int
  seatingCapacity Int
  vehiclePurpose  VehiclePurpose
  vehicleStatus   VehicleStatus

  ownerName        String
  ownerType        OwnerType
  nationalId       String
  passportNumber   String
  companyRegNumber String
  address          String
  mobile           String
  email            String

  plateNumber        String?             @unique
  registrationStatus RegistrationStatus?
  registrationDate   DateTime
  expiryDate         DateTime
  state              String
  plateType          PlateType

  policyNumber        String
  companyName         String
  insuranceExpiryDate DateTime
  insuranceStatus     InsuranceStatus?
  insuranceType       String
  roadworthyCert      String
  customsRef          String
  proofOfOwnership    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
